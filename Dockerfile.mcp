FROM python:3.13-alpine3.23

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN addgroup -S mcp && adduser -S -D -H -G mcp mcp

WORKDIR /opt/tandoor-mcp
COPY requirements-mcp.txt ./
RUN python -m pip install --no-cache-dir -r requirements-mcp.txt

COPY tandoor_mcp ./tandoor_mcp
RUN chown -R mcp:mcp /opt/tandoor-mcp
USER mcp

EXPOSE 8765

CMD ["python", "-m", "tandoor_mcp", "--transport", "streamable-http", "--host", "0.0.0.0", "--port", "8765"]
